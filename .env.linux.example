# Copy to .env before running: cp .env.linux.example .env
# Use URL-safe, long, random values for both passwords.
POSTGRES_PASSWORD=change-this-to-a-long-random-url-safe-password
SHIXUE_PORTAL_ADMIN_PASSWORD=change-this-to-a-long-admin-password
SHIXUE_PORTAL_ADMIN_USERNAME=admin
SHIXUE_MODEL_API_KEY=

# Host port used by LAN browsers. The portal itself listens on 8765 inside Docker.
WENJIN_PORT=18765
# Data lives on the WSL ext4 filesystem, not on the Docker Desktop C: disk.
WENJIN_DATA_DIR=/root/wenjin-data
