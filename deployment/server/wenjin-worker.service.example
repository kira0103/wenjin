[Unit]
Description=Wenjin execution worker
After=network.target

[Service]
Type=simple
User=wenjin
Group=wenjin
WorkingDirectory=/opt/wenjin
EnvironmentFile=/etc/wenjin/server.env
ExecStart=/opt/wenjin/.venv/bin/python -m backend.worker --data-dir /var/lib/wenjin
Restart=on-failure
RestartSec=5
TimeoutStopSec=240
UMask=0077

[Install]
WantedBy=multi-user.target
